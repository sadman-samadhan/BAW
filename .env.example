# Copy to .env.local and fill in. Everything here is optional: the site builds and runs without it.

# Public site URL used for canonical links, sitemap and Open Graph images.
NEXT_PUBLIC_SITE_URL=https://bigapeweb.com

# Meta Pixel. Leave empty to load no Facebook code at all.
NEXT_PUBLIC_META_PIXEL_ID=

# Contact form email via Resend (https://resend.com). Without a key the form points people to WhatsApp.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Big Ape Web <hello@bigapeweb.com>"
